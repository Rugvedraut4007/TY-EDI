# MedSure backend configuration
# Copy this file to `.env` and fill in your PostgreSQL details.

PORT=5000

DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=medicine_system

# Secrets
JWT_SECRET=change-this-to-a-long-random-string
BILL_SALT=change-this-bill-verification-salt

# Frontend origin used inside generated verification QR codes
CLIENT_URL=http://localhost:3000
